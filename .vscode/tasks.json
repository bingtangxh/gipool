    "tasks": [
        {
            "label": "Build gipool (MinGW)",
            "type": "shell",
            "command": ".\\build_mingw.cmd",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "C:\\Windows\\System32\\cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "使用 MinGW GCC 构建整个仓库"
        },
